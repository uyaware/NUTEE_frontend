{
  "name": "nutee-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/be-vietnam-pro": "^5.2.6",
    "@hookform/resolvers": "5.2.2",
    "@mui/icons-material": "^7.3.0",
    "@mui/material": "^7.3.0",
    "@tanstack/react-query": "^5.90.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.71.2",
    "react-router-dom": "7.14.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.56.0",
    "@types/node": "22.19.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "6.4.1",
    "vitest": "3.1.2"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --ignore-path .prettierignore --write src tests docs/service-contract.md docs/m0-m1-acceptance.md docs/m2-acceptance.md docs/m3-acceptance.md design-system README.md *.json *.ts *.js index.html",
    "format:check": "prettier --ignore-path .prettierignore --check src tests docs/service-contract.md docs/m0-m1-acceptance.md docs/m2-acceptance.md docs/m3-acceptance.md design-system README.md *.json *.ts *.js index.html"
  }
}
